      "diff": "--- before/test_bucket_items_isolation.py\n+++ after/test_bucket_items_isolation.py\n@@ -0,0 +1,20 @@\n+from source import Bucket\n+\n+\n+def test_instances_have_independent_items():\n+    b1 = Bucket()\n+    b2 = Bucket()\n+\n+    b1.add(1)\n+    b2.add(2)\n+\n+    assert b1.items == [1]\n+    assert b2.items == [2]\n+\n+\n+def test_new_instance_starts_empty_after_other_instance_add():\n+    b1 = Bucket()\n+    b1.add(\"x\")\n+\n+    b2 = Bucket()\n+    assert b2.items == []\n"
