  "test_changes": [
    {
      "path": "test_money_rounding.py",
      "at": "2026-11-13T15:20:54.604626+00:00",
      "diff": "--- before/test_money_rounding.py\n+++ after/test_money_rounding.py\n@@ -0,0 +1,24 @@\n+from decimal import Decimal\n+\n+import pytest\n+\n+from source import money\n+\n+\n+@pytest.mark.parametrize(\n+    \"amount, expected\",\n+    [\n+        # 正常值：非临界舍入\n+        (\"1.234\", Decimal(\"1.23\")),\n+        (\"1.236\", Decimal(\"1.24\")),\n+        (\"0.00\", Decimal(\"0.00\")),\n+        # 临界值：ROUND_HALF_UP 的 .xx5 边界\n+        (\"1.235\", Decimal(\"1.24\")),\n+        (\"2.675\", Decimal(\"2.68\")),\n+        (\"-2.675\", Decimal(\"-2.68\")),\n+    ],\n+)\n+def test_money_rounds_half_up_to_two_places(amount, expected):\n+    result = money(amount)\n+    assert isinstance(result, Decimal)\n+    assert result == expected\n"
    }
  ],
