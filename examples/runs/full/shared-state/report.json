  "test_changes": [
    {
      "path": "test_bucket_isolation.py",
      "at": "2026-11-13T15:19:57.211956+00:00",
      "diff": "--- before/test_bucket_isolation.py\n+++ after/test_bucket_isolation.py\n@@ -0,0 +1,23 @@\n+from source import Bucket\n+\n+\n+def test_new_instance_starts_with_empty_items():\n+    \"\"\"新建实例的 items 应为空，不受其他实例 add 影响。\"\"\"\n+    a = Bucket()\n+    a.add(1)\n+\n+    b = Bucket()\n+    assert a.items == [1]\n+    assert b.items == []\n+\n+\n+def test_two_instances_keep_independent_items():\n+    \"\"\"两个实例各自 add 后，items 应互不干扰。\"\"\"\n+    a = Bucket()\n+    b = Bucket()\n+\n+    a.add(\"x\")\n+    b.add(\"y\")\n+\n+    assert a.items == [\"x\"]\n+    assert b.items == [\"y\"]\n"
    }
  ],
