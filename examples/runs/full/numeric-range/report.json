  "test_changes": [
    {
      "path": "test_numeric_range_huge_eq_hash.py",
      "at": "2026-11-13T15:21:38.888688+00:00",
      "diff": "--- before/test_numeric_range_huge_eq_hash.py\n+++ after/test_numeric_range_huge_eq_hash.py\n@@ -0,0 +1,58 @@\n+\"\"\"numeric_range 的等值比较与 hash 应支持元素数量超过 sys.maxsize 的范围。\n+\n+内置 range 的 == 与 hash 不依赖 len()，因此 range(10**30) 可以正常比较与哈希；\n+numeric_range 应保持一致。显式 len() 仍允许抛 OverflowError。\n+\"\"\"\n+\n+import sys\n+\n+import pytest\n+\n+from more_itertools import numeric_range\n+\n+HUGE = 10**30\n+\n+\n+def test_small_range_eq_and_hash_still_work():\n+    # 正常值校验：小范围行为不变\n+    a = numeric_range(0, 10, 2)\n+    b = numeric_range(0, 10, 2)\n+    assert a == b\n+    assert hash(a) == hash(b)\n+    assert a != numeric_range(0, 10, 3)\n+    assert len(a) == 5\n+\n+\n+def test_huge_range_equality_does_not_overflow():\n+    a = numeric_range(HUGE)\n+    b = numeric_range(HUGE)\n+    # 与内置 range 一致：等值比较不应抛 OverflowError\n+    assert a == b\n+    assert not (a != b)\n+\n+\n+def test_huge_range_inequality_does_not_overflow():\n+    a = numeric_range(HUGE)\n+    assert a != numeric_range(HUGE, 2 * HUGE)\n+    assert a != numeric_range(HUGE, step=2)\n+\n+\n+def test_huge_range_hash_does_not_overflow():\n+    a = numeric_range(HUGE)\n+    b = numeric_range(HUGE)\n+    h = hash(a)\n+    assert isinstance(h, int)\n+    assert h == hash(b)\n+\n+\n+def test_huge_range_len_still_raises_overflow():\n+    # 显式 len() 仍可抛 OverflowError（与内置 range 一致）\n+    with pytest.raises(OverflowError):\n+        len(numeric_range(HUGE))\n+    with pytest.raises(OverflowError):\n+        len(range(HUGE))\n+\n+\n+def test_huge_range_usable_as_dict_key():\n+    d = {numeric_range(HUGE): 'value'}\n+    assert d[numeric_range(HUGE)] == 'value'\n"
    },
    {
